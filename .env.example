# Copy this file to .env.local for local development, and set the same
# variables in the deployment platform's project settings (e.g. Vercel ->
# Project -> Settings -> Environment Variables). Never commit the real
# values - .env.local and friends are gitignored; only this example file is
# tracked.

# Resend (https://resend.com) API key, used by src/app/api/contact/route.ts
# to send the Contact page's enquiries. Create a Resend account for Clady
# Food Group (or Discoverable, if sending on their behalf), generate an API
# key, and paste it here/in the deployment env vars. See the setup notes at
# the top of src/app/api/contact/route.ts for the full checklist.
RESEND_API_KEY=

# The "from" address the contact form's emails are sent as. Requires
# cladyfoodgroup.com to be added and DNS-verified as a sending domain in
# Resend (SPF/DKIM records) first - until then, leave this unset and the
# route falls back to Resend's shared onboarding@resend.dev sender, which
# works without domain verification but isn't a production sender.
# e.g. enquiries@cladyfoodgroup.com
CONTACT_FROM_EMAIL=
